{
  "framework": null,
  "buildCommand": "mkdir -p dist && cp index.html dist/ && cp -r web assets dist/",
  "outputDirectory": "dist",
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
